"""Generated P0 tabular regression baseline using LightGBM."""

import json
from pathlib import Path

import joblib
import lightgbm as lgb
import numpy as np
import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.metrics import mean_squared_error
from sklearn.model_selection import KFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OrdinalEncoder

DATA_DIR = Path({{ data_dir | tojson }})
OUTPUT_DIR = Path({{ output_dir | tojson }})
TRAIN_FILE = {{ choice.train_file | tojson }}
TEST_FILE = {{ choice.test_file | tojson }}
SAMPLE_SUBMISSION_FILE = {{ choice.sample_submission_file | tojson }}
TARGET_COLUMN = {{ choice.target_column | tojson }}
ID_COLUMN = {{ choice.id_column | tojson }}
CV_FOLDS = {{ cv_folds }}
RANDOM_SEED = {{ random_seed }}


def load_data() -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    required = {
        "training": TRAIN_FILE,
        "test": TEST_FILE,
        "sample submission": SAMPLE_SUBMISSION_FILE,
    }
    missing_roles = [role for role, name in required.items() if not name]
    if missing_roles:
        raise ValueError(f"Missing file metadata for: {', '.join(missing_roles)}")

    return (
        pd.read_csv(DATA_DIR / TRAIN_FILE),
        pd.read_csv(DATA_DIR / TEST_FILE),
        pd.read_csv(DATA_DIR / SAMPLE_SUBMISSION_FILE),
    )


def build_model(X: pd.DataFrame) -> Pipeline:
    numeric_columns = list(X.select_dtypes(include=[np.number, "bool"]).columns)
    categorical_columns = [column for column in X.columns if column not in numeric_columns]

    transformers = []
    if numeric_columns:
        transformers.append(
            (
                "numeric",
                SimpleImputer(strategy="median"),
                numeric_columns,
            )
        )
    if categorical_columns:
        transformers.append(
            (
                "categorical",
                Pipeline(
                    steps=[
                        ("imputer", SimpleImputer(strategy="most_frequent")),
                        (
                            "encoder",
                            OrdinalEncoder(
                                handle_unknown="use_encoded_value",
                                unknown_value=-1,
                            ),
                        ),
                    ]
                ),
                categorical_columns,
            )
        )

    preprocessor = ColumnTransformer(transformers=transformers)
    regressor = lgb.LGBMRegressor(
        n_estimators=300,
        learning_rate=0.05,
        random_state=RANDOM_SEED,
        verbose=-1,
    )
    return Pipeline(steps=[("preprocess", preprocessor), ("model", regressor)])


def main() -> None:
    train, test, sample_submission = load_data()
    if not TARGET_COLUMN or TARGET_COLUMN not in train.columns:
        raise ValueError(f"Target column is invalid: {TARGET_COLUMN!r}")
    if not ID_COLUMN or ID_COLUMN not in test.columns:
        raise ValueError(f"ID column is invalid: {ID_COLUMN!r}")

    feature_columns = [column for column in train.columns if column != TARGET_COLUMN]
    missing_test_columns = [column for column in feature_columns if column not in test.columns]
    if missing_test_columns:
        raise ValueError(f"Test data is missing feature columns: {missing_test_columns}")

    X = train[feature_columns]
    X_test = test[feature_columns]
    y = train[TARGET_COLUMN].to_numpy(dtype=float)

    oof = np.zeros(len(train), dtype=float)
    test_predictions = []
    models = []
    splitter = KFold(n_splits=CV_FOLDS, shuffle=True, random_state=RANDOM_SEED)

    for train_idx, val_idx in splitter.split(X):
        model = build_model(X.iloc[train_idx])
        model.fit(X.iloc[train_idx], y[train_idx])
        oof[val_idx] = model.predict(X.iloc[val_idx])
        test_predictions.append(model.predict(X_test))
        models.append(model)

    # `mean_squared_error(..., squared=False)` was removed in newer
    # scikit-learn (the `squared` kwarg is gone as of 1.6), so RMSE is
    # computed manually for compatibility across versions.
    cv_rmse = float(np.sqrt(mean_squared_error(y, oof)))
    predicted = np.mean(test_predictions, axis=0)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(
        {
            ID_COLUMN: train[ID_COLUMN],
            "actual": y,
            "prediction": oof,
        }
    ).to_csv(OUTPUT_DIR / "oof.csv", index=False)

    metrics = {"cv_rmse": float(cv_rmse), "cv_folds": CV_FOLDS}
    (OUTPUT_DIR / "metrics.json").write_text(json.dumps(metrics, indent=2))

    models_dir = OUTPUT_DIR / "models"
    models_dir.mkdir(exist_ok=True)
    for index, model in enumerate(models):
        joblib.dump(model, models_dir / f"fold_{index}.joblib")

    if len(sample_submission) != len(test):
        raise ValueError(
            "Sample submission and test data row counts differ: "
            f"{len(sample_submission)} != {len(test)}"
        )
    submission = sample_submission.copy()
    submission[ID_COLUMN] = test[ID_COLUMN].to_numpy()
    submission[TARGET_COLUMN] = predicted
    submission.to_csv(OUTPUT_DIR / "submission.csv", index=False)

    print(f"CV RMSE: {cv_rmse:.4f}")


if __name__ == "__main__":
    main()
