# Kaggle API token (preferred; create one at https://www.kaggle.com/settings)
KAGGLE_API_TOKEN=your_api_token

# Legacy Kaggle credentials are also supported
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# LLM provider for brief + reflection generation (optional — leave unset and
# LabPilot falls back to template-only text instead of failing).
# OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
LABPILOT_LLM_PROVIDER=gemini
# LABPILOT_LLM_MODEL=gemini-3.5-flash

# Optional overrides
# LABPILOT_RUNS_DIR=runs
# LABPILOT_KNOWLEDGE_DIR=knowledge
# LABPILOT_LLM_PROVIDER=gemini
# LABPILOT_LLM_MODEL=gemini-3.5-flash
