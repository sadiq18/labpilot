# Kaggle API token (preferred; create one at https://www.kaggle.com/settings)
KAGGLE_API_TOKEN=your_api_token

# Legacy Kaggle credentials are also supported
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# LLM (optional — leave unset and LabPilot falls back to templates / rule_engine).
# Cloud: Gemini (default) or OpenAI. Local coding: Ollama qwen2.5-coder:14b
# (see llm.tasks in configs/default.yaml).
# OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
LABPILOT_LLM_PROVIDER=gemini
LABPILOT_LLM_MODEL=gemini-3.5-flash-lite
LABPILOT_LLM_MODE=cloud   # auto | local | cloud — use cloud for Gemini demos
# OLLAMA_HOST=http://localhost:11434

# Optional literature / GitHub APIs (Plans 6–7). Leave unset to soft-fail / rate-limit.
# SEMANTIC_SCHOLAR_API_KEY=your_s2_key
# OPENALEX_MAILTO=you@example.com
# OPENALEX_API_KEY=your_openalex_key
# HF_TOKEN=your_huggingface_token
# GitHub PAT for repository search/fetch (recommended; public-repo read is enough)
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token

# Optional overrides
# LABPILOT_RUNS_DIR=runs
# LABPILOT_KNOWLEDGE_DIR=knowledge
# LABPILOT_LLM_PROVIDER=gemini
# LABPILOT_LLM_MODEL=gemini-3.5-flash
# LABPILOT_LLM_MODE=local
