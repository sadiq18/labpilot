"""Generated P0 tabular classification baseline using LightGBM."""


import json
import time
from pathlib import Path

import joblib
import lightgbm as lgb
import numpy as np
import pandas as pd
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.model_selection import StratifiedKFold
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import LabelEncoder, OrdinalEncoder

from labpilot.research_engine.execution.metrics import compute_metric

DATA_DIR = Path({{ data_dir | py }})
OUTPUT_DIR = Path({{ output_dir | py }})
TRAIN_FILE = {{ choice.train_file | py }}
TEST_FILE = {{ choice.test_file | py }}
SAMPLE_SUBMISSION_FILE = {{ choice.sample_submission_file | py }}
TARGET_COLUMN = {{ choice.target_column | py }}
ID_COLUMN = {{ choice.id_column | py }}
METRIC_NAME = {{ choice.metric_name | py }}
CV_FOLDS = {{ cv_folds }}
RANDOM_SEED = {{ random_seed }}
MODEL_PARAMS = {{ model_params | py }}
FEATURE_RECIPES = {{ feature_recipes | py }}
TARGET_ENCODING_COLUMNS = {{ target_encoding_columns | py }}
LOG_NUMERIC_COLUMNS = {{ log_numeric_columns | py }}


def load_data() -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    required = {
        "training": TRAIN_FILE,
        "test": TEST_FILE,
        "sample submission": SAMPLE_SUBMISSION_FILE,
    }
    missing_roles = [role for role, name in required.items() if not name]
    if missing_roles:
        raise ValueError(f"Missing file metadata for: {', '.join(missing_roles)}")

    return (
        pd.read_csv(DATA_DIR / TRAIN_FILE),
        pd.read_csv(DATA_DIR / TEST_FILE),
        pd.read_csv(DATA_DIR / SAMPLE_SUBMISSION_FILE),
    )


{% if "log_numeric" in feature_recipes %}
def apply_log_numeric(frame: pd.DataFrame) -> pd.DataFrame:
    result = frame.copy()
    for column in LOG_NUMERIC_COLUMNS:
        if column in result.columns:
            result[column] = np.log1p(result[column].clip(lower=0))
    return result
{% endif %}


{% if "target_encoding" in feature_recipes %}
def apply_target_encoding(
    train_frame: pd.DataFrame,
    other_frames: list[pd.DataFrame],
    target: np.ndarray,
    columns: list[str],
) -> tuple[pd.DataFrame, list[pd.DataFrame]]:
    train_out = train_frame.copy()
    others_out = [frame.copy() for frame in other_frames]
    global_mean = float(np.mean(target))
    for column in columns:
        if column not in train_frame.columns:
            continue
        temp = train_frame[[column]].copy()
        temp["_target"] = target
        mapping = temp.groupby(column)["_target"].mean().to_dict()
        counts = temp.groupby(column).size().to_dict()
        smooth = 10.0
        encoded = {
            key: (counts.get(key, 0) * mapping.get(key, global_mean) + smooth * global_mean)
            / (counts.get(key, 0) + smooth)
            for key in mapping
        }
        train_out[f"{column}_te"] = train_frame[column].map(encoded).fillna(global_mean)
        for frame, out in zip(other_frames, others_out, strict=True):
            out[f"{column}_te"] = frame[column].map(encoded).fillna(global_mean)
    return train_out, others_out
{% endif %}


def build_model(X: pd.DataFrame) -> Pipeline:
    numeric_columns = list(X.select_dtypes(include=[np.number, "bool"]).columns)
    categorical_columns = [column for column in X.columns if column not in numeric_columns]

    transformers = []
    if numeric_columns:
        transformers.append(
            (
                "numeric",
                SimpleImputer(strategy="median"),
                numeric_columns,
            )
        )
    if categorical_columns:
        transformers.append(
            (
                "categorical",
                Pipeline(
                    steps=[
                        ("imputer", SimpleImputer(strategy="most_frequent")),
                        (
                            "encoder",
                            OrdinalEncoder(
                                handle_unknown="use_encoded_value",
                                unknown_value=-1,
                            ),
                        ),
                    ]
                ),
                categorical_columns,
            )
        )

    preprocessor = ColumnTransformer(transformers=transformers)
    params = dict(MODEL_PARAMS)
    params.setdefault("random_state", RANDOM_SEED)
    classifier = lgb.LGBMClassifier(**params)
    return Pipeline(steps=[("preprocess", preprocessor), ("model", classifier)])


def main() -> None:
    train, test, sample_submission = load_data()
    if not TARGET_COLUMN or TARGET_COLUMN not in train.columns:
        raise ValueError(f"Target column is invalid: {TARGET_COLUMN!r}")
    if not ID_COLUMN or ID_COLUMN not in test.columns:
        raise ValueError(f"ID column is invalid: {ID_COLUMN!r}")

    feature_columns = [column for column in train.columns if column != TARGET_COLUMN]
    missing_test_columns = [column for column in feature_columns if column not in test.columns]
    if missing_test_columns:
        raise ValueError(f"Test data is missing feature columns: {missing_test_columns}")

    X = train[feature_columns]
    X_test = test[feature_columns]
{% if "log_numeric" in feature_recipes %}
    X = apply_log_numeric(X)
    X_test = apply_log_numeric(X_test)
{% endif %}
    encoder = LabelEncoder()
    y = encoder.fit_transform(train[TARGET_COLUMN])
    num_classes = len(encoder.classes_)
    if num_classes < 2:
        raise ValueError(f"Classification target needs at least two classes, got {num_classes}.")

    smallest_class = int(np.bincount(y).min())
    folds = min(CV_FOLDS, smallest_class)
    if folds < 2:
        raise ValueError("Each target class needs at least two rows for cross-validation.")

    oof_proba = np.zeros((len(train), num_classes), dtype=float)
    test_proba = np.zeros((len(test), num_classes), dtype=float)
    models = []
    fold_scores: list[float] = []
    splitter = StratifiedKFold(n_splits=folds, shuffle=True, random_state=RANDOM_SEED)

    train_t0 = time.perf_counter()
    for train_idx, val_idx in splitter.split(X, y):
        X_train = X.iloc[train_idx]
        X_val = X.iloc[val_idx]
        X_test_fold = X_test
{% if "target_encoding" in feature_recipes %}
        fold_train = train.iloc[train_idx]
        X_train, encoded = apply_target_encoding(
            fold_train[feature_columns],
            [X_val, X_test_fold],
            y[train_idx],
            TARGET_ENCODING_COLUMNS,
        )
        X_val, X_test_fold = encoded
{% endif %}
        model = build_model(X_train)
        model.fit(X_train, y[train_idx])
        oof_proba[np.ix_(val_idx, model.classes_)] = model.predict_proba(X_val)
        test_proba[:, model.classes_] += model.predict_proba(X_test_fold)
        models.append(model)
        fold_pred = oof_proba[val_idx].argmax(axis=1)
        fold_proba = None
        if METRIC_NAME in ("auc", "logloss") and num_classes == 2:
            fold_proba = oof_proba[val_idx][:, 1]
        fold_scores.append(
            float(
                compute_metric(
                    y[val_idx],
                    fold_pred,
                    METRIC_NAME,
                    y_proba=fold_proba,
                    num_classes=num_classes,
                )
            )
        )
    train_elapsed = time.perf_counter() - train_t0

    oof_codes = oof_proba.argmax(axis=1)
    proba_for_metric = None
    if METRIC_NAME in ("auc", "logloss") and num_classes == 2:
        proba_for_metric = oof_proba[:, 1]
    cv_score = compute_metric(
        y,
        oof_codes,
        METRIC_NAME,
        y_proba=proba_for_metric,
        num_classes=num_classes,
    )
    cv_std = float(np.std(fold_scores)) if len(fold_scores) > 1 else 0.0
    predicted_codes = (test_proba / folds).argmax(axis=1)
    predicted_labels = encoder.inverse_transform(predicted_codes)

    infer_t0 = time.perf_counter()
    _ = models[-1].predict_proba(X_test) if models else None
    infer_elapsed = time.perf_counter() - infer_t0
    peak_mem = None
    try:
        import resource
        import sys

        usage = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
        peak_mem = float(usage) / (1024.0 * 1024.0) if sys.platform == "darwin" else float(usage) / 1024.0
    except Exception:
        peak_mem = None

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(
        {
            ID_COLUMN: train[ID_COLUMN],
            "actual": train[TARGET_COLUMN],
            "prediction": encoder.inverse_transform(oof_codes),
            "confidence": oof_proba.max(axis=1),
        }
    ).to_csv(OUTPUT_DIR / "oof.csv", index=False)

    metrics = {
        f"cv_{METRIC_NAME}": float(cv_score),
        "cv_folds": folds,
        "cv_fold_scores": [float(x) for x in fold_scores] if fold_scores else [],
        "cv_mean": float(cv_score),
        "cv_std": float(cv_std) if fold_scores and len(fold_scores) > 1 else 0.0,
        "num_classes": num_classes,
        "train_time_s": float(train_elapsed),
        "inference_time_s": float(infer_elapsed),
        "peak_memory_mb": peak_mem,
    }
    (OUTPUT_DIR / "metrics.json").write_text(json.dumps(metrics, indent=2))

    models_dir = OUTPUT_DIR / "models"
    models_dir.mkdir(exist_ok=True)
    for index, model in enumerate(models):
        joblib.dump(model, models_dir / f"fold_{index}.joblib")

    if len(sample_submission) != len(test):
        raise ValueError(
            "Sample submission and test data row counts differ: "
            f"{len(sample_submission)} != {len(test)}"
        )
    submission = sample_submission.copy()
    submission[ID_COLUMN] = test[ID_COLUMN].to_numpy()
    submission[TARGET_COLUMN] = predicted_labels
    submission.to_csv(OUTPUT_DIR / "submission.csv", index=False)

    print(f"CV {METRIC_NAME}: {cv_score:.4f}")


if __name__ == "__main__":
    main()
