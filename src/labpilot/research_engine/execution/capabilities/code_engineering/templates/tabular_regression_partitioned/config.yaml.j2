competition: {{ competition }}
problem_type: tabular_regression
template: tabular_regression_partitioned
cv_folds: {{ cv_folds }}
random_seed: {{ random_seed }}
model: lightgbm
target_column: {{ choice.target_column or "auto" }}
id_column: {{ choice.id_column or "auto" }}
validation:
  scheme: {{ choice.validation.scheme }}
  group_key: {{ choice.validation.group_key or "auto" }}
  holdout_fraction: {{ choice.validation.holdout_fraction }}
  exclude_features: {{ choice.validation.exclude_features | tojson }}
  rationale: {{ choice.validation.rationale | tojson }}
