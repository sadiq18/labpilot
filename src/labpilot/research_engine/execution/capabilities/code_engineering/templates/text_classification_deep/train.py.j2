"""Opt-in deep text baseline: fine-tuned DistilBERT transfer learning."""

import json
from pathlib import Path

import numpy as np
import pandas as pd
import torch
from sklearn.model_selection import StratifiedKFold
from sklearn.preprocessing import LabelEncoder
from torch.utils.data import DataLoader, Dataset
from transformers import AutoModelForSequenceClassification, AutoTokenizer

from labpilot.research_engine.execution.metrics import compute_metric

DATA_DIR = Path({{ data_dir | py }})
OUTPUT_DIR = Path({{ output_dir | py }})
TRAIN_FILE = {{ choice.train_file | py }}
TEST_FILE = {{ choice.test_file | py }}
SAMPLE_SUBMISSION_FILE = {{ choice.sample_submission_file | py }}
TARGET_COLUMN = {{ choice.target_column | py }}
ID_COLUMN = {{ choice.id_column | py }}
TEXT_COLUMN = {{ choice.text_column | py }}
METRIC_NAME = {{ choice.metric_name | py }}
MAX_EPOCHS = {{ deep.max_epochs }}
MAX_TRAIN_SAMPLES = {{ deep.max_train_samples }}
BATCH_SIZE = {{ deep.batch_size }}
LEARNING_RATE = {{ deep.learning_rate }}
CPU_MAX_EPOCHS = {{ deep.cpu_max_epochs }}
CPU_MAX_TRAIN_SAMPLES = {{ deep.cpu_max_train_samples }}
CV_FOLDS = {{ deep.cv_folds }}
RANDOM_SEED = {{ random_seed }}


class TextDataset(Dataset):
    def __init__(self, texts, labels, tokenizer, max_length=128):
        self.encodings = tokenizer(
            list(texts), truncation=True, padding=True, max_length=max_length, return_tensors="pt"
        )
        self.labels = torch.tensor(labels, dtype=torch.long)

    def __len__(self):
        return len(self.labels)

    def __getitem__(self, idx):
        item = {key: val[idx] for key, val in self.encodings.items()}
        item["labels"] = self.labels[idx]
        return item


def train_fold(model, loader, device, epochs, lr):
    model.to(device)
    optimizer = torch.optim.AdamW(model.parameters(), lr=lr)
    model.train()
    for _ in range(epochs):
        for batch in loader:
            batch = {k: v.to(device) for k, v in batch.items()}
            outputs = model(**batch)
            loss = outputs.loss
            loss.backward()
            optimizer.step()
            optimizer.zero_grad()
    return model


def predict_proba(model, loader, device, num_classes):
    model.eval()
    probs = []
    with torch.no_grad():
        for batch in loader:
            labels = batch.pop("labels")
            batch = {k: v.to(device) for k, v in batch.items()}
            logits = model(**batch).logits
            prob = torch.softmax(logits, dim=-1).cpu().numpy()
            probs.append(prob)
    if not probs:
        return np.zeros((0, num_classes))
    return np.vstack(probs)


def main() -> None:
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    max_epochs = MAX_EPOCHS if device.type == "cuda" else CPU_MAX_EPOCHS
    max_samples = MAX_TRAIN_SAMPLES if device.type == "cuda" else CPU_MAX_TRAIN_SAMPLES

    train = pd.read_csv(DATA_DIR / TRAIN_FILE)
    test = pd.read_csv(DATA_DIR / TEST_FILE)
    sample_submission = pd.read_csv(DATA_DIR / SAMPLE_SUBMISSION_FILE)
    if len(train) > max_samples:
        train = train.sample(max_samples, random_state=RANDOM_SEED)

    encoder = LabelEncoder()
    y = encoder.fit_transform(train[TARGET_COLUMN])
    num_classes = len(encoder.classes_)
    texts = train[TEXT_COLUMN].astype(str)
    test_texts = test[TEXT_COLUMN].astype(str)

    tokenizer = AutoTokenizer.from_pretrained("distilbert-base-uncased")
    folds = min(CV_FOLDS, int(np.bincount(y).min()))
    oof_proba = np.zeros((len(train), num_classes), dtype=float)
    test_proba = np.zeros((len(test), num_classes), dtype=float)

    splitter = StratifiedKFold(n_splits=folds, shuffle=True, random_state=RANDOM_SEED)
    for train_idx, val_idx in splitter.split(texts, y):
        model = AutoModelForSequenceClassification.from_pretrained(
            "distilbert-base-uncased", num_labels=num_classes
        )
        train_ds = TextDataset(texts.iloc[train_idx], y[train_idx], tokenizer)
        loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True)
        model = train_fold(model, loader, device, max_epochs, LEARNING_RATE)

        val_ds = TextDataset(texts.iloc[val_idx], y[val_idx], tokenizer)
        val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE)
        fold_proba = predict_proba(model, val_loader, device, num_classes)
        oof_proba[val_idx, : fold_proba.shape[1]] = fold_proba

        test_ds = TextDataset(test_texts, np.zeros(len(test_texts)), tokenizer)
        test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE)
        test_proba += predict_proba(model, test_loader, device, num_classes)

    oof_codes = oof_proba.argmax(axis=1)
    proba_for_metric = oof_proba[:, 1] if num_classes == 2 and METRIC_NAME in ("auc", "logloss") else None
    cv_score = compute_metric(
        y, oof_codes, METRIC_NAME, y_proba=proba_for_metric, num_classes=num_classes
    )
    predicted_codes = (test_proba / folds).argmax(axis=1)
    predicted_labels = encoder.inverse_transform(predicted_codes)

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(
        {
            ID_COLUMN: train[ID_COLUMN],
            "actual": train[TARGET_COLUMN],
            "prediction": encoder.inverse_transform(oof_codes),
        }
    ).to_csv(OUTPUT_DIR / "oof.csv", index=False)
    metrics = {f"cv_{METRIC_NAME}": float(cv_score), "cv_folds": folds}
    (OUTPUT_DIR / "metrics.json").write_text(json.dumps(metrics, indent=2))

    models_dir = OUTPUT_DIR / "models"
    models_dir.mkdir(exist_ok=True)
    for index in range(folds):
        (models_dir / f"fold_{index}.json").write_text(
            json.dumps(
                {
                    "model": "distilbert-base-uncased",
                    "epochs": max_epochs,
                    "device": str(device),
                }
            )
        )

    submission = sample_submission.copy()
    submission[ID_COLUMN] = test[ID_COLUMN].to_numpy()
    submission[TARGET_COLUMN] = predicted_labels
    submission.to_csv(OUTPUT_DIR / "submission.csv", index=False)
    print(f"CV {METRIC_NAME}: {cv_score:.4f} on {device}")


if __name__ == "__main__":
    main()
