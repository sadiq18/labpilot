<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>LabPilot Report — {{ competition_slug }}</title>
  <style>
    :root {
      --bg: #f6f8fb;
      --card: #ffffff;
      --text: #1a1f36;
      --muted: #5c6370;
      --accent: #2563eb;
      --border: #e5e7eb;
      --success: #059669;
      --warning: #d97706;
      --danger: #dc2626;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.55;
    }
    .container { max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
    header {
      background: linear-gradient(135deg, #1e3a8a, #2563eb);
      color: #fff;
      padding: 2rem 1.25rem;
      border-radius: 12px;
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 24px rgba(37, 99, 235, 0.18);
    }
    header h1 { margin: 0 0 0.35rem; font-size: 1.75rem; }
    header .meta { opacity: 0.92; font-size: 0.95rem; }
    .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-bottom: 1.5rem; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1.1rem 1.25rem;
      box-shadow: 0 1px 2px rgba(16, 24, 40, 0.04);
    }
    .card h2, section h2 {
      margin: 0 0 0.75rem;
      font-size: 1.05rem;
      color: var(--text);
    }
    .metric-value { font-size: 1.6rem; font-weight: 700; color: var(--accent); }
    .label { color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; }
    section { margin-bottom: 1.5rem; }
    section > .card { padding: 1.25rem 1.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    th, td { text-align: left; padding: 0.55rem 0.65rem; border-bottom: 1px solid var(--border); vertical-align: top; }
    th { color: var(--muted); font-weight: 600; }
    .status-complete, .status-completed { color: var(--success); font-weight: 600; }
    .status-failed { color: var(--danger); font-weight: 600; }
    .status-skipped, .status-partial, .status-running { color: var(--warning); font-weight: 600; }
    .markdown h1, .markdown h2, .markdown h3 { margin-top: 1.2rem; margin-bottom: 0.5rem; }
    .markdown p, .markdown ul, .markdown ol { margin: 0.5rem 0; }
    .markdown code { background: #f3f4f6; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.9em; }
    .markdown pre { background: #111827; color: #f9fafb; padding: 0.85rem; border-radius: 8px; overflow-x: auto; }
    footer { color: var(--muted); font-size: 0.85rem; text-align: center; margin-top: 2rem; }
    a { color: var(--accent); }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>{{ competition.title or competition_slug }}</h1>
      <div class="meta">
        Run <code>{{ run_id }}</code> · Status <strong>{{ manifest_status }}</strong> · Generated {{ generated_at }}
        {% if dashboard_href %}
        · <a href="{{ dashboard_href }}" style="color:#bfdbfe;">Competition dashboard</a>
        {% endif %}
      </div>
    </header>

    <div class="grid">
      {% if metrics %}
      {% for key, value in metrics.items() %}
      <div class="card">
        <div class="label">{{ key }}</div>
        <div class="metric-value">{{ value }}</div>
      </div>
      {% endfor %}
      {% else %}
      <div class="card">
        <div class="label">Metrics</div>
        <div>No metrics.json recorded for this run.</div>
      </div>
      {% endif %}

      <div class="card">
        <div class="label">Baseline</div>
        <div><strong>{{ baseline.template_name if baseline else "n/a" }}</strong></div>
        {% if baseline %}
        <div style="margin-top:0.4rem;color:var(--muted);font-size:0.92rem;">
          {{ baseline.problem_type }} · metric {{ baseline.metric_name }}
        </div>
        {% endif %}
      </div>

      {% if submission %}
      <div class="card">
        <div class="label">Submission</div>
        <div><strong>{{ submission.status }}</strong></div>
        {% if submission.public_score is not none %}
        <div style="margin-top:0.4rem;">Public score: <strong>{{ submission.public_score }}</strong></div>
        {% endif %}
        {% if submission.submissions_url %}
        <div style="margin-top:0.4rem;"><a href="{{ submission.submissions_url }}">Kaggle submissions</a></div>
        {% endif %}
        {% if submission.kernel_url %}
        <div style="margin-top:0.4rem;"><a href="{{ submission.kernel_url }}">Kernel notebook</a></div>
        {% endif %}
      </div>
      {% endif %}

      {% if runtime %}
      <div class="card">
        <div class="label">Runtime</div>
        <div><strong>{{ runtime.runtime_id }}</strong> ({{ runtime.provider }})</div>
        <div style="margin-top:0.4rem;color:var(--muted);font-size:0.92rem;">Mode: {{ runtime.mode }}</div>
      </div>
      {% endif %}
    </div>

    {% if competition %}
    <section>
      <div class="card">
        <h2>Competition</h2>
        <table>
          <tbody>
            <tr><th>Slug</th><td>{{ competition.slug }}</td></tr>
            {% if competition.evaluation_metric %}
            <tr><th>Metric</th><td>{{ competition.evaluation_metric.name }}{% if competition.evaluation_metric.key %} ({{ competition.evaluation_metric.key }}){% endif %}</td></tr>
            {% endif %}
            <tr><th>Submission mode</th><td>{{ competition.submission_mode }}</td></tr>
            {% if competition.deadline %}<tr><th>Deadline</th><td>{{ competition.deadline }}</td></tr>{% endif %}
            {% if competition.data_url %}<tr><th>Data</th><td><a href="{{ competition.data_url }}">{{ competition.data_url }}</a></td></tr>{% endif %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if profile %}
    <section>
      <div class="card">
        <h2>Dataset profile</h2>
        <table>
          <tbody>
            <tr><th>Modality</th><td>{{ profile.modality }}</td></tr>
            <tr><th>Train rows</th><td>{{ profile.row_count }}</td></tr>
            <tr><th>Test rows</th><td>{{ profile.test_row_count }}</td></tr>
            <tr><th>Target</th><td>{{ profile.target_column }}</td></tr>
            <tr><th>ID column</th><td>{{ profile.id_column }}</td></tr>
            {% if profile.train_file %}<tr><th>Train file</th><td>{{ profile.train_file }}</td></tr>{% endif %}
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    {% if lineage %}
    <section>
      <div class="card">
        <h2>Iteration lineage</h2>
        <table>
          <tbody>
            <tr><th>Parent run</th><td>{{ lineage.parent_run_id }}</td></tr>
            <tr><th>Iteration</th><td>{{ lineage.iteration }}</td></tr>
            <tr><th>Strategy</th><td>{{ lineage.improvement_strategy }}</td></tr>
          </tbody>
        </table>
      </div>
    </section>
    {% endif %}

    <section>
      <div class="card markdown">
        <h2>Research brief</h2>
        {{ brief_html | safe }}
      </div>
    </section>

    {% if profile_html %}
    <section>
      <div class="card markdown">
        <h2>Profile notes</h2>
        {{ profile_html | safe }}
      </div>
    </section>
    {% endif %}

    <section>
      <div class="card markdown">
        <h2>Reflection &amp; next steps</h2>
        {{ reflection_html | safe }}
      </div>
    </section>

    <section>
      <div class="card">
        <h2>Pipeline stages</h2>
        <table>
          <thead>
            <tr><th>Stage</th><th>Status</th><th>Started</th><th>Finished</th></tr>
          </thead>
          <tbody>
            {% for stage in stages %}
            <tr>
              <td>{{ stage.name }}</td>
              <td class="status-{{ stage.status }}">{{ stage.status }}</td>
              <td>{{ stage.started_at }}</td>
              <td>{{ stage.finished_at }}</td>
            </tr>
            {% if stage.error %}
            <tr><td colspan="4" style="color:var(--danger);">{{ stage.error }}</td></tr>
            {% endif %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <footer>Generated by LabPilot · Self-contained HTML report for run {{ run_id }}</footer>
  </div>
</body>
</html>
