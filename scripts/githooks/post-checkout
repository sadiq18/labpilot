#!/usr/bin/env bash
# Git post-checkout: run after `git checkout <branch>` (not file checkouts).
# Keeps Obsidian vault aligned when switching branches locally.

set -e

# $3 == 1 → branch checkout; 0 → file checkout
if [[ "${3:-0}" != "1" ]]; then
  exit 0
fi

if [[ "${LABPILOT_SKIP_OBSIDIAN_SYNC:-}" == "1" ]]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/sync-obsidian-vault.sh" "$ROOT"
