#!/usr/bin/env bash
# Git post-merge: run after `git pull` / merge completes.
# Syncs repo docs → ~/Documents/Obsidian Vault/autonomous-research-engineer

set -e

if [[ "${LABPILOT_SKIP_OBSIDIAN_SYNC:-}" == "1" ]]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/sync-obsidian-vault.sh" "$ROOT"
