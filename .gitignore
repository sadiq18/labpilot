# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Environment
.env

# Run artifacts
runs/

# Research memory (hypotheses, knowledge base) — local, like runs/
# Anchored to repo root so it never ignores the source package
# src/labpilot/research_engine/intelligence/knowledge/.
/knowledge/

# Per-competition workspaces (data, pipeline, artifacts) from `research run`
/competitions/

# Local Obsidian reference (plans/milestones copies — not part of the package)
obsidian-vault/

# Kaggle download cache (shared across runs, safe to delete)
.cache/

# Per-competition contracts are created locally (see configs/competitions/README.md)
# and are not committed, so the engine stays generic across competitions.
configs/competitions/*.yaml
configs/competitions/*.yml
!configs/competitions/README.md

# IDE / agent tooling
.idea/
.vscode/
*.swp

# Local mirrors of AGENTS.md, which is the source of truth for agent guidance.
# Tracking a copy means it drifts: someone edits AGENTS.md, the mirror keeps
# saying the old thing, and the tool injects the stale version automatically
# (these carry `alwaysApply: true`). Listed by name rather than as a glob so
# `.cursor/rules/design-doc.mdc` is not swept up by accident.
skills/karpathy-guidelines/
.cursor/rules/growth-areas.mdc
.cursor/rules/karpathy-guidelines.mdc

# Third-party plugin manifests — local tooling, not project guidance.
.claude-plugin/marketplace.json
.claude-plugin/plugin.json

# Local config (developer-specific, not committed)
# .claude/settings.json - uncomment if adding local overrides
# .cursor/settings.json - uncomment if adding local overrides
CLAUDE.md

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Local env backups
.env.bak*

# Shared experience store — a local SQLite DB, never committed
experiences.db
experiences.db.writelock

# The corpus keeps captured competition data; its bytecode does not belong in it
tests/integration/__pycache__/
